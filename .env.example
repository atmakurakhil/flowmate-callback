# Copy to .env (git ignores it) and fill in. Never commit real values.
# Mock mode needs none of this:  python3 -m flowmate_callback demo

FLOWMATE_MODE=live

# Bolna (https://platform.bolna.ai/developers -> API Keys; shown once)
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Optional. Leave empty to use Bolna's default +91 number.
BOLNA_FROM_NUMBER=

# Public HTTPS address of this server (a tunnel or a deploy). Bolna posts webhooks and tool calls here.
FLOWMATE_PUBLIC_BASE_URL=https://

# Make these with:  python3 -m flowmate_callback secrets
FLOWMATE_INBOUND_TOKEN=
FLOWMATE_WEBHOOK_TOKEN=
FLOWMATE_TOOL_TOKEN=
FLOWMATE_ADMIN_TOKEN=
CALCOM_WEBHOOK_SECRET=

# Who live mode may call. Empty = nobody. Put only your own verified test number(s) here
# until a real client goes live; "*" means anyone who gave consent.
FLOWMATE_LIVE_ALLOWLIST=

# Reject requests that are not from Bolna's three source IPs (on by default in live mode).
FLOWMATE_ENFORCE_BOLNA_IPS=1
# Set to 1 only if a tunnel or proxy in front of you sets X-Forwarded-For.
FLOWMATE_TRUST_PROXY=0

# Optional
# FLOWMATE_PROFILE=profiles/your-client.json
# FLOWMATE_DB=data/callback.db
# CALCOM_CONSENT_FIELD=callback_consent
